# MCP-ResQ Environment Configuration

# Google Maps API Key
# OPTION A: If you have ONLY ONE Google Maps key, set this (used for BOTH browser and backend Routes API):
GOOGLE_MAPS_API_KEY=

# OPTION B: Or if you have separate keys for browser and backend:
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=

# Google Maps Map ID for vector / advanced markers (optional)
GOOGLE_MAPS_MAP_ID=

# Google Gemini API Key (for Incident AI Reasoning)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash


# Environment & Server Config
APP_ENV=development
API_PORT=8000
API_HOST=0.0.0.0
DEV_OPERATOR_TOKEN=dev-secret-operator-key-2026
DATABASE_PATH=mcp_resq.db
LOG_LEVEL=INFO
